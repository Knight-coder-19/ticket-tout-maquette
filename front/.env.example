# Aucune de ces variables n'est necessaire pour demarrer.
# Sans fichier .env, l'application tourne en mode mocks, servie par les
# routes de src/app/api : le depot seul suffit a la faire fonctionner.
# Copier ce fichier en .env.local uniquement pour brancher un vrai backend.

# Bascule entre les donnees simulees et l'API reelle.
# Valeur par defaut si absente : mocks actifs.
# false : le front interroge NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCKS=true

# URL de l'API backend. Aucune valeur par defaut en dur dans le code.
# Obligatoire uniquement si NEXT_PUBLIC_USE_MOCKS=false : dans ce cas,
# son absence fait echouer le demarrage, pas un ecran au milieu du parcours.
# En mode mocks, la cible est le serveur Next lui-meme, sous /api.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Duree de validite d'un code de paiement, en secondes.
# Contrainte T. Vignal : 300 maximum.
NEXT_PUBLIC_QR_TTL_SECONDS=300

# Nom affiche dans toute l'interface. Contrainte B. Sellami.
NEXT_PUBLIC_APP_NAME=CartePro
