# CartePro — variables d'environnement (section 10 de CLAUDE.md)
# Copier en `.env` pour le developpement. `.env` n'est JAMAIS commite.

# --- Base de donnees ---------------------------------------------------------
# Role applicatif : sans droits UPDATE/DELETE sur les tables du journal (0010).
DATABASE_URL=postgres://cartepro_app:cartepro@localhost:5432/cartepro
# Role distinct utilise uniquement par `cargo sqlx migrate run`.
MIGRATION_DATABASE_URL=postgres://cartepro_owner:cartepro@localhost:5432/cartepro

# --- Reseau ------------------------------------------------------------------
# L'application n'est jamais exposee directement : Caddy termine TLS.
BIND_ADDR=127.0.0.1:8080
PUBLIC_ORIGIN=https://cartepro.example
TRUSTED_PROXY=127.0.0.1

# --- Secrets -----------------------------------------------------------------
# Cle privee Ed25519, base64. La plus sensible du systeme : JAMAIS commitee.
TOKEN_SIGNING_KEY=
# Cle publique correspondante, distribuee a l'application partenaire
# pour la verification hors ligne des jetons (CLAUDE.md §9.5).
TOKEN_PUBLIC_KEY=

# --- Durees ------------------------------------------------------------------
SESSION_TTL_HOURS=12
TOKEN_TTL_SECONDS=300

# --- Parametres ouverts ------------------------------------------------------
RESYNC_MAX_AGE_HOURS=72
CLOSURE_GRACE_DAYS=30

# --- Exploitation ------------------------------------------------------------
RUST_LOG=info,cartepro=debug
# `development` desactive le refus du trafic en clair et expose /docs.
ENVIRONMENT=development

# --- Surface publique non authentifiee (A3) ----------------------------------
# Duree du Cache-Control des reponses de /public.
PUBLIC_CACHE_SECONDS=300
